{
    "name": "kitodo/publication",
    "type": "typo3-cms-extension",
    "description": "Plugins and modules for publication management with Fedora repositories.",
    "homepage": "https://github.com/kitodo/kitodo-publication",
    "readme":"README.md",
    "license": ["GPL-3.0-or-later"],
    "keywords": [
        "TYPO3",
        "Fedora",
        "extension",
        "publishing"
    ],
    "authors": [
        {
            "name": "Ralf Claußnitzer",
            "email": "ralf.claussnitzer@slub-dresden.de",
            "homepage": "https://www.slub-dresden.de",
            "role": "Maintainer"
        },
        {
            "name": "effective Webwork GmbH",
            "email": "info@effective-webwork.de",
            "homepage": "https://effective-webwork.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/kitodo/kitodo-publication/issues",
        "source": "https://github.com/kitodo/kitodo-publication"
    },
    "require": {
        "php": "^7.0",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "typo3/cms-core": "^8.7.0",
        "nategood/httpful": "^0.2.20"
    },
    "require-dev": {
        "nimut/testing-framework": "*",
        "phpstan/phpstan": "^2.0",
        "phpmd/phpmd": "^2.15",
        "kitodo/presentation": "~v3.2.3",
        "squizlabs/php_codesniffer": "^3.13",
        "phpcompatibility/php-compatibility": "^9.3",
        "dealerdirect/phpcodesniffer-composer-installer": "*"
    },
    "replace": {
        "typo3-ter/dpf": "self.version"
    },
    "autoload": {
        "psr-4": {
            "EWW\\Dpf\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "dpf"
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "block": false
            }
        },
        "allow-plugins": {
            "typo3/cms-composer-installers": false,
            "typo3/class-alias-loader": false,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "mess": "@php vendor/bin/phpmd Classes/ text phpmd.xml --baseline-file phpmd.baseline.xml"
    }
}
